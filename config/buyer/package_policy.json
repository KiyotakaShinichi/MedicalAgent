{
  "schema_version": "nlcare_buyer_package_policy_v1",
  "required_paths": [
    "README.md",
    "pyproject.toml",
    "uv.lock",
    "frontend-react/package-lock.json",
    "backend/migrations/versions/0001_baseline.py",
    "config/buyer/asset_manifest.json",
    "config/buyer/license_inventory.json",
    "config/buyer/candidate.json",
    "docs/buyer/README.md",
    "scripts/verify_buyer_candidate.py",
    "scripts/seed_buyer_demo.py",
    "scripts/reset_buyer_demo.py"
  ],
  "excluded_patterns": [
    ".env",
    ".env.local",
    ".env.development",
    ".env.production",
    ".env.test",
    ".venv/**",
    "node_modules/**",
    "__pycache__/**",
    "*.pyc",
    "*.pyo",
    "*.log",
    "tmp/**",
    "logs/**",
    "reports/coverage.xml",
    "*.db",
    "*.sqlite",
    "*.sqlite3",
    "Data/external_bridge/**",
    "Data/external_validation/**",
    "Data/breastdcedl_*",
    "Data/models/breastdcedl_*",
    "KnowledgeBase/raw/research_papers/**"
  ],
  "forbidden_in_archive": [
    ".env",
    ".env.local",
    ".env.development",
    ".env.production",
    ".env.test",
    "*.pem",
    "*.key",
    "id_rsa*",
    "*.p12",
    "*.pfx",
    "*.db",
    "*.sqlite",
    "*.sqlite3",
    "tmp/**",
    "logs/**",
    "node_modules/**",
    ".venv/**"
  ]
}
