GROQ_API_KEY=replace_with_your_groq_key
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=llama-3.3-70b-versatile
GROQ_ADJUDICATION_TIMEOUT_SECONDS=3
LLM_ADJUDICATION_ENABLED=true

# Optional local app settings
APP_ENV=development
ENVIRONMENT=development
ALLOW_DEMO_AUTH=false
NLCARE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8017,http://127.0.0.1:8017
DATABASE_URL=sqlite:///./medical_agent.db
SQLITE_TIMEOUT_SECONDS=30
NLCARE_PATIENT_ENRICHMENT_PREWARM_ENABLED=true
NLCARE_PATIENT_REPORT_CACHE_TTL_SECONDS=900
NLCARE_PATIENT_CORE_CACHE_TTL_SECONDS=120
NLCARE_ENRICHMENT_WORKERS=1

# Docker Compose overrides DATABASE_URL with Postgres automatically.
# For manual Postgres runs:
# DATABASE_URL=postgresql+psycopg2://medical_agent:medical_agent@127.0.0.1:5432/medical_agent
REDIS_URL=redis://127.0.0.1:6379/0

# Optional RAG reranking. Disabled by default because first run downloads a model.
RAG_ENABLE_CROSS_ENCODER=false
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Fail readiness when a deployment promises dense retrieval but the runtime
# only has the sparse TF-IDF/BM25 fallback. Keep false for the lightweight
# disposable demo; production profiles set this to true.
NLCARE_RAG_REQUIRE_DENSE=false
# Use a deployment-specific path so runtimes with different serializer and
# retrieval dependencies never overwrite one another's persisted index.
NLCARE_RAG_INDEX_PATH=Data/rag_index/local_hybrid_rag_index.joblib

# Managed vector stores are shadow candidates only. The live patient route
# remains local FAISS + BM25 + RRF until a frozen parity evaluation supports
# promotion. Never place patient IDs, raw chat, or PHI in these indexes.
NLCARE_VECTOR_BACKEND=local_faiss
NLCARE_MANAGED_VECTOR_SHADOW_ENABLED=false
NLCARE_MANAGED_VECTOR_ALLOW_NETWORK=false
NLCARE_VECTOR_DIMENSION=384

# Optional Azure AI Search shadow adapter. Prefer a short-lived Entra bearer
# token from managed identity. The API-key field exists only for compatibility
# with an externally managed dev service; the checked-in Bicep disables local
# authentication.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_API_VERSION=2026-04-01
AZURE_SEARCH_NAMESPACE=nlcare_kb_demo_t1_t3
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_BEARER_TOKEN=

# Optional Pinecone shadow adapter.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=nlcare-kb-shadow
PINECONE_NAMESPACE_KB=nlcare_kb_demo_t1_t3
PINECONE_API_VERSION=2025-10

# Optional MLflow mirroring. The local JSON/DB registry works without MLflow.
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=file:./Data/mlruns_mlflow

# Optional local Ollama fallback/learning sandbox.
# Groq is primary when GROQ_API_KEY is set; Ollama is for local experiments or fallback only.
# Leave OLLAMA_MODEL blank to skip Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=3

# Optional redacted internal notification automation. Disabled by default.
# Connect the imported high_risk_review_alert workflow to approved email,
# SMS, or Viber nodes inside n8n; never put patient identity or raw chat here.
N8N_WEBHOOK_DISPATCH_ENABLED=false
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook/nlcare
N8N_WEBHOOK_SIGNING_SECRET=replace_with_a_long_random_secret
NLCARE_ALERT_NOTIFICATION_MAX_ATTEMPTS=3
NLCARE_ALERT_NOTIFICATION_RETRY_BASE_SECONDS=30
NLCARE_ALERT_TEST_RECIPIENT_ONLY=true

# Never commit real API keys or patient data.
