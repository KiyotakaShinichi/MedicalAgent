    },
    {
      "path": "Data/evals/rag/latest_rag_intent_aware_eval.json",
      "required": true,
      "max_age_days": 30,
      "accepted_status": ["strong", "acceptable"],
      "metric_thresholds": [
        {"path": ["summary", "pass_rate"], "op": ">=", "value": 0.95},
        {"path": ["summary", "unsafe_answer_rate"], "op": "<=", "value": 0.0}
      ]
    },
    {
      "path": "Data/evals/rag/latest_rag_claim_validation_eval.json",
      "required": true,
      "max_age_days": 60,
      "accepted_status": ["strong", "acceptable"],
      "metric_thresholds": [
        {"path": ["summary", "hard_failures"], "op": "==", "value": 0}
      ]
    },
    {
      "path": "Data/evals/rag/latest_rag_tier_ablation.json",
      "required": true,
      "max_age_days": 60,
      "accepted_status": ["strong", "acceptable", "needs_attention"],
      "_note": "needs_attention is accepted: the runner now uses the LIVE agent (was a deterministic stub). The live pass_rate is lower because the canonical 28-case set includes T1-only configs that legitimately refuse most education queries. Surface as informational; do not block ship."
