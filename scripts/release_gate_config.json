    },
    {
      "path": "Data/evals/models/latest_leakage_audit.json",
      "required": true,
      "max_age_days": 60,
      "accepted_status": ["passed", "strong", "acceptable"],
      "metric_thresholds": [
        {"path": ["summary", "checks_failed"], "op": "==", "value": 0}
      ]
    },
    {
      "path": "Data/evals/models/latest_shortcut_audit.json",
